#!/bin/zsh -f
#
# Scripts/layout
# mas
#
# Copyright © 2026 mas-cli. All rights reserved.
#
# Reports lines wider than their .editorconfig max_line_length (counting each tab as 2 characters); prose paragraphs in
# Markdown files & in comments whose lines aren't filled up to their limit before wrapping (80 characters for Markdown &
# Swift comments; the file's max_line_length for `#` comments); Markdown tables & fenced blocks wider than 80 characters
# but not wrapped in line-length-disabling comments, or vice versa; & Markdown fenced block lines wider than 160
# characters.
#
# Usage: layout [-f]
#
# -f: rewrap reported paragraphs instead of reporting them, wide lines, tables & fenced blocks; exit 1 iff any file is
#     rewrapped
#

. "${0:A:h}/_setup-script"

zmodload zsh/zutil
zparseopts -D -F -A received_flag f
readonly -A received_flag

export LC_CTYPE=en_US.UTF-8

readonly separator=$'\x1f'
readonly space=$'\x1e'
readonly inline_start_regex='[\`<]'
readonly backtick_run_regex='`+'
readonly html_tag_regex=$'^(<!--([^-]|-[^-])*-->|</?[A-Za-z][-A-Za-z0-9]*( +[A-Za-z_:][-A-Za-z0-9_.:]*( *= *("[^"]*"|\'[^\']*\'|[^ "\'=<>`]+))?)* */?>)'
readonly start_danger_regex='^([-*+]|#{1,6}|=+|[0-9]+[.)])$|^>'
readonly markdown_list_regex='^( *)([-*+]|[0-9]+\.)( +)'
readonly markdown_special_regex='^(```|[|#<>]|http|\[[^]]+\]:)'
readonly link_url_start_regex='\]\( *$'
readonly swift_comment_regex=$'^(\t*)(///?) (.*)$'
readonly swift_marker_regex='^(swiftlint|swiftformat|periphery|MARK|TODO|FIXME|sourcery|```)'
readonly hash_comment_regex=$'^([ \t]*)(#) (.*)$'
readonly hash_marker_regex='^(shellcheck|yamllint|editorconfig-checker|yaml-language-server|TODO|FIXME)'
readonly hash_comment_file_regex='^(.*\.(bash|fish|ini|yaml|yml|zsh)|\.editorconfig|\.gitattributes|\.gitignore|Brewfile|CODEOWNERS)$'
readonly comment_list_regex='^([-*+]|[0-9]+\.) '
readonly header_end_regex='^(//|#) mas$'
readonly editorconfig_section_regex='^\[(.*)\]$'
readonly editorconfig_max_line_length_regex='^max_line_length *= *([^ ]+)'
readonly integer_regex='^[0-9]+$'

# shellcheck disable=SC2034
typeset -a tokens filled source_lines result_lines match mbegin mend
# shellcheck disable=SC2034
typeset MATCH MBEGIN MEND
integer exit_status=0 limit
max_line_length=''

# Each .editorconfig section's max_line_length, keyed by the section's glob converted to a zsh pattern (the last
# matching section wins)
typeset -a max_line_length_patterns=() max_line_lengths=()
section=''
# shellcheck disable=SC2066
for line in "${(@f)"$(<.editorconfig)"}"; do
	if [[ "${line}" =~ ${editorconfig_section_regex} ]]; then
		section="${match[1]}"
	elif [[ -n "${section}" && "${line}" =~ ${editorconfig_max_line_length_regex} ]]; then
		max_line_length_patterns+=("${${${section//\{/(}//,/|}//\}/)}")
		max_line_lengths+=("${match[1]}")
	fi
done

# Splits ${1} at spaces into tokens, keeping each code span & inline HTML tag whole (per CommonMark: a code span opens
# with an unescaped backtick run & closes with the next backtick run of the same length; an unclosed run is literal)
tokenize() {
	local rest="${1}" protected='' run after content
	local -i run_length is_closed
	while [[ "${rest}" =~ ${inline_start_regex} ]]; do
		protected+="${rest[1,MBEGIN - 1]}"
		rest="${rest[MBEGIN,-1]}"
		if [[ "${rest}" == \\* ]]; then
			protected+="${rest[1,2]}"
			rest="${rest[3,-1]}"
		elif [[ "${rest}" == \`* ]]; then
			run="${(M)rest##\`##}"
			run_length="${#run}"
			after="${rest[run_length + 1,-1]}"
			content=''
			is_closed=0
			while [[ "${after}" =~ ${backtick_run_regex} ]]; do
				content+="${after[1,MEND]}"
				after="${after[MEND + 1,-1]}"
				if ((MEND - MBEGIN + 1 == run_length)); then
					is_closed=1
					break
				fi
			done
			if ((is_closed)); then
				protected+="${run}${content// /${space}}"
				rest="${after}"
			else
				protected+="${run}"
				rest="${rest[run_length + 1,-1]}"
			fi
		elif [[ "${rest}" =~ ${html_tag_regex} ]]; then
			protected+="${MATCH// /${space}}"
			rest="${rest[MEND + 1,-1]}"
		else
			protected+='<'
			rest="${rest[2,-1]}"
		fi
	done
	protected+="${rest}"
	tokens=("${(@)${(@s: :)protected}//${space}/ }")
}

# Greedily fills tokens ${@:3} into lines prefixed by ${1} (1st line) or ${2}
fill() {
	local -a prefixes=() lines=()
	local prefix="${1}" line='' token
	for token in "${@:3}"; do
		if [[ -n "${line}" ]] && ((${#${prefix//$'\t'/  }} + ${#${line//${separator}/ }} + 1 + ${#token} > limit)); then
			prefixes+=("${prefix}")
			lines+=("${line}")
			prefix="${2}"
			line="${token}"
		else
			line+="${line:+${separator}}${token}"
		fi
	done
	prefixes+=("${prefix}")
	lines+=("${line}")
	# Never start a line with a token that Markdown would interpret as a block marker
	local -i index moved=1
	while ((moved)); do
		moved=0
		for ((index = 2; index <= ${#lines}; ++index)); do
			if [[ "${lines[index]%%${separator}*}" =~ ${start_danger_regex} ]]\
			&& [[ "${lines[index - 1]}" == *${separator}* ]]; then
				lines[index]="${lines[index - 1]##*${separator}}${separator}${lines[index]}"
				lines[index - 1]="${lines[index - 1]%${separator}*}"
				moved=1
			fi
		done
	done
	filled=()
	for ((index = 1; index <= ${#lines}; ++index)); do
		filled+=("${prefixes[index]}${lines[index]//${separator}/ }")
	done
}

# Replaces source lines ${2}–${3} of file ${1} with the filled lines iff they differ & fit within the limit
apply_filled() {
	local -a old_lines=("${(@)source_lines[${2},${3}]}")
	local filled_line
	for filled_line in "${filled[@]}"; do
		if ((${#${filled_line//$'\t'/  }} > limit)); then
			result_lines+=("${old_lines[@]}")
			return
		fi
	done
	if [[ "${(pj:\n:)filled}" == "${(pj:\n:)old_lines}" ]]; then
		result_lines+=("${old_lines[@]}")
	else
		result_lines+=("${filled[@]}")
		if ! [[ -v 'received_flag[-f]' ]]; then
			printf $'%s:%d: Paragraph not filled to %d characters\n' "${1}" "${2}" "${limit}"
			exit_status=1
		fi
	fi
}

is_markdown_special() {
	local -r stripped="${${1##[[:space:]]#}%%[[:space:]]#}"
	[[ -z "${stripped}" || "${stripped}" =~ ${markdown_special_regex} ]]\
	|| [[ "${1}" =~ ${link_url_start_regex} || "${1}" == *$'\t'* ]]
}

is_hard_break() {
	[[ "${1}" == *'  ' || "${1}" == *\\ ]]
}

layout_markdown() {
	local line first rest indentation
	local -a body
	local -i index=1 end in_fence=0
	while ((index <= ${#source_lines})); do
		line="${source_lines[index]}"
		if [[ "${line}" == [[:space:]]#'```'* ]]; then
			in_fence=$((!in_fence))
		fi
		if ((in_fence)) || [[ "${line}" == [[:space:]]#'```'* ]] || is_markdown_special "${line}"; then
			result_lines+=("${line}")
			index+=1
			continue
		fi
		if [[ "${line}" =~ ${markdown_list_regex} ]]; then
			first="${MATCH}"
			rest="${MATCH//?/ }"
			body=("${line:${#MATCH}}")
		else
			first="${(M)line##[ ]#}"
			rest="${first}"
			body=("${line#"${first}"}")
		fi
		end=$((index + 1))
		while ((end <= ${#source_lines})) && ! is_hard_break "${source_lines[end - 1]}"; do
			line="${source_lines[end]}"
			indentation="${(M)line##[ ]#}"
			if is_markdown_special "${line}"\
			|| [[ "${line}" =~ ${markdown_list_regex} || "${line}" == [[:space:]]#')'* ]]\
			|| ((${#indentation} != ${#rest})); then
				break
			fi
			body+=("${line#"${indentation}"}")
			end+=1
		done
		if is_hard_break "${source_lines[end - 1]}" || [[ "${(j: :)body}" == *'  '* ]]; then
			result_lines+=("${(@)source_lines[index,end - 1]}")
		else
			tokenize "${(j: :)body}"
			fill "${first}" "${rest}" "${tokens[@]}"
			apply_filled "${1}" "${index}" "$((end - 1))"
		fi
		index="${end}"
	done
}

# Fills the comment paragraphs of file ${1}, whose comment lines match regex ${2} & whose linter / formatter markers
# match regex ${3}
layout_comments() {
	local line indentation slashes body hang first
	local -a bodies
	local -i index end is_list header_end=0
	for ((index = 1; index <= ${#source_lines} && index <= 10; ++index)); do
		if [[ "${source_lines[index]}" =~ ${header_end_regex} ]]; then
			header_end="${index}"
			break
		fi
	done
	index=1
	while ((index <= ${#source_lines})); do
		line="${source_lines[index]}"
		if ((index <= header_end)) || ! [[ "${line}" =~ ${2} ]]; then
			result_lines+=("${line}")
			index+=1
			continue
		fi
		indentation="${match[1]}"
		slashes="${match[2]}"
		body="${match[3]}"
		if [[ -z "${body// }" || "${body}" =~ ${3} ]]\
		|| { [[ "${body}" == ' '* ]] && ! [[ "${body}" =~ ${comment_list_regex} ]]; }; then
			result_lines+=("${line}")
			index+=1
			continue
		fi
		if [[ "${body}" =~ ${comment_list_regex} ]]; then
			is_list=1
			hang="${MATCH//?/ }"
		else
			is_list=0
			hang=''
		fi
		bodies=("${body}")
		end=$((index + 1))
		while ((end <= ${#source_lines})); do
			if ! [[ "${source_lines[end]}" =~ ${2} ]]\
			|| [[ "${match[1]}" != "${indentation}" || "${match[2]}" != "${slashes}" ]]; then
				break
			fi
			body="${match[3]}"
			if [[ -z "${body// }" || "${body}" =~ ${3} ]]; then
				break
			fi
			if ((is_list)); then
				if [[ "${body}" != "${hang}"* || "${body}" == "${hang} "* ]]; then
					break
				fi
				bodies+=("${body#"${hang}"}")
			else
				if [[ "${body}" == ' '* || "${body}" =~ ${comment_list_regex} ]]; then
					break
				fi
				bodies+=("${body}")
			fi
			end+=1
		done
		if [[ "${(j: :)bodies}" == *'  '* ]]; then
			result_lines+=("${(@)source_lines[index,end - 1]}")
		else
			first="${indentation}${slashes} "
			tokenize "${(j: :)bodies}"
			fill "${first}" "${first}${hang}" "${tokens[@]}"
			apply_filled "${1}" "${index}" "$((end - 1))"
		fi
		index="${end}"
	done
}

# Sets max_line_length to that of file ${1}
set_max_line_length() {
	local -i index
	max_line_length=''
	for ((index = 1; index <= ${#max_line_length_patterns}; ++index)); do
		# shellcheck disable=SC2053
		if [[ "${1:t}" == ${~max_line_length_patterns[index]} ]]; then
			max_line_length="${max_line_lengths[index]}"
		fi
	done
}

# Reports each line of file ${1} wider than its max_line_length, except lines disabled via editorconfig-checker comments
check_line_lengths() {
	local line
	local -i index is_disabled=0 is_next_disabled=0
	if ! [[ "${max_line_length}" =~ ${integer_regex} ]] || [[ "${(pj:\n:)source_lines}" == *editorconfig-checker-disable-file* ]]; then
		return
	fi
	for ((index = 1; index <= ${#source_lines}; ++index)); do
		line="${source_lines[index]}"
		if [[ "${line}" == *editorconfig-checker-enable* ]]; then
			is_disabled=0
		elif [[ "${line}" == *editorconfig-checker-disable* && "${line}" != *editorconfig-checker-disable-line* ]]\
		&& [[ "${line}" != *editorconfig-checker-disable-next-line* ]]; then
			is_disabled=1
		elif ! ((is_disabled || is_next_disabled)) && [[ "${line}" != *editorconfig-checker-disable-line* ]]\
		&& ((${#${line//$'\t'/  }} > max_line_length)); then
			printf $'%s:%d: Line is %d characters wide (the limit is %d)\n' "${1}" "${index}" "${#${line//$'\t'/  }}" "${max_line_length}"
			exit_status=1
		fi
		is_next_disabled=0
		if [[ "${line}" == *editorconfig-checker-disable-next-line* ]]; then
			is_next_disabled=1
		fi
	done
}

# Reports each table or fenced block in Markdown file ${1} that's wider than 80 characters (counting each tab as 2
# characters) but not wrapped in comments disabling editorconfig-checker & markdownlint's line-length, each wrapped one
# that's no wider than 80 characters, & each fenced block line that's wider than 160 characters
check_markdown_blocks() {
	local line kind
	local -i index=1 end line_index line_width block_width is_wrapped
	while ((index <= ${#source_lines})); do
		line="${source_lines[index]##[[:space:]]#}"
		if [[ "${line}" == '```'* ]]; then
			kind='Fenced block'
			end=$((index + 1))
			while ((end < ${#source_lines})) && [[ "${source_lines[end]##[[:space:]]#}" != '```'* ]]; do
				end+=1
			done
		elif [[ "${line}" == '|'* ]]; then
			kind='Table'
			end="${index}"
			while ((end < ${#source_lines})) && [[ "${source_lines[end + 1]##[[:space:]]#}" == '|'* ]]; do
				end+=1
			done
		else
			index+=1
			continue
		fi
		block_width=0
		for ((line_index = index; line_index <= end; ++line_index)); do
			line="${source_lines[line_index]}"
			line_width="${#${line//$'\t'/  }}"
			if [[ "${kind}" == 'Fenced block' ]] && ((line_width > 160)); then
				printf $'%s:%d: Fenced block line is %d characters wide (split it into lines no wider than 160)\n'\
					"${1}" "${line_index}" "${line_width}"
				exit_status=1
			fi
			((block_width = line_width > block_width ? line_width : block_width))
		done
		is_wrapped=0
		if ((index > 2 && end + 2 <= ${#source_lines}))\
		&& [[ "${source_lines[index - 2]##[[:space:]]#}" == '<!--editorconfig-checker-disable-->' ]]\
		&& [[ "${source_lines[index - 1]##[[:space:]]#}" == '<!--markdownlint-disable line-length-->' ]]\
		&& [[ "${source_lines[end + 1]##[[:space:]]#}" == '<!--markdownlint-enable line-length-->' ]]\
		&& [[ "${source_lines[end + 2]##[[:space:]]#}" == '<!--editorconfig-checker-enable-->' ]]; then
			is_wrapped=1
		fi
		if ((block_width > 80 && !is_wrapped)); then
			printf $'%s:%d: %s is %d characters wide, but not wrapped in line-length-disabling comments\n'\
				"${1}" "${index}" "${kind}" "${block_width}"
			exit_status=1
		elif ((block_width <= 80 && is_wrapped)); then
			printf $'%s:%d: %s is %d characters wide, but wrapped in line-length-disabling comments\n'\
				"${1}" "${index}" "${kind}" "${block_width}"
			exit_status=1
		fi
		index=$((end + 1))
	done
}

for file in ${(0)"$(GIT_LITERAL_PATHSPECS=1 git grep --no-index -Ilz '' -- "${(@0)"$(non_ignored_files)"}")"}; do
	source_lines=("${(@f)"$(<"${file}")"}")
	result_lines=()
	set_max_line_length "${file}"
	if ! [[ -v 'received_flag[-f]' ]]; then
		check_line_lengths "${file}"
		if [[ "${file}" == *.md ]]; then
			check_markdown_blocks "${file}"
		fi
	fi
	limit=80
	if [[ "${file}" == *.md ]]; then
		layout_markdown "${file}"
	elif [[ "${file}" == *.swift ]]; then
		layout_comments "${file}" "${swift_comment_regex}" "${swift_marker_regex}"
	elif [[ "${file:t}" =~ ${hash_comment_file_regex} || "${source_lines[1]}" == '#!'* ]]\
	&& [[ "${max_line_length}" =~ ${integer_regex} ]]; then
		limit="${max_line_length}"
		layout_comments "${file}" "${hash_comment_regex}" "${hash_marker_regex}"
	else
		continue
	fi
	if [[ -v 'received_flag[-f]' && "${(pj:\n:)result_lines}" != "${(pj:\n:)source_lines}" ]]; then
		print -r -- "${(pj:\n:)result_lines}" >"${file}"
		printf $'Rewrapped %s\n' "${file}"
		exit_status=1
	fi
done

exit "${exit_status}"
